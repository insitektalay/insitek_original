// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/* ─────────────────────────────
   Updated Transcript model to support both YouTube and Podcast
   ───────────────────────────── */

enum TranscriptSource {
  YOUTUBE
  PODCAST
  IMAGE
}

model Transcript {
  id              String   @id @default(uuid())
  youtubeId       String?  @unique  // Make this optional since podcasts won't have it
  title           String
  channel         String
  channelId       String?  // YouTube channel ID for avatar fetching
  channelAvatarUrl String?  // YouTube channel profile picture URL
  text            String   @db.Text
  segments     Json?    // Array of {start, end, text} objects with timestamps
  description  String?  // AI-generated short description
  summary      String?  @db.Text  // AI-generated detailed summary (500-1000 words)
  publishDate  DateTime?
  importedAt   DateTime @default(now())
  source       TranscriptSource @default(YOUTUBE)  // Track the source
  sourceUrl    String?  // Store the original URL (YouTube or podcast audio URL)
  imageFilename String?  // Original filename for image-based transcripts

  createdAt    DateTime @default(now())

  // Relations
  insightSources      InsightSource[]      // Transcripts that contributed to insights
  documents           Document[]           // Documents generated from this transcript
  documentExtractions DocumentExtraction[] // NEW: Extractions for documents
  queueVideos         QueueVideo[]         // Queue videos linked to this transcript
  agentDocuments      AgentDocument[]      // Agent-based documents using this transcript
  agentNotes          AgentNote[]          // Notes taken by agent from this transcript
  chunks              TranscriptChunk[]    // Chunked version for scalable access
  metadata            TranscriptMetadata?  // Metadata for chunk management
}

/* ─────────────────────────────
   Transcript Chunking for Scalability
   Allows handling 50+ transcripts without context limits
   ───────────────────────────── */

model TranscriptChunk {
  id              String    @id @default(uuid())
  transcriptId    String
  chunkIndex      Int       // Sequential index: 0, 1, 2...
  startTime       String?   // "00:15:30" (if timestamp available)
  endTime         String?   // "00:25:00"
  content         String    @db.Text
  wordCount       Int
  summary         String?   @db.Text  // AI-generated summary of this chunk
  keywords        String[]  // Extracted keywords for search
  createdAt       DateTime  @default(now())

  transcript      Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@unique([transcriptId, chunkIndex])
  @@index([transcriptId])
  @@index([keywords])
}

model TranscriptMetadata {
  id              String    @id @default(uuid())
  transcriptId    String    @unique
  totalChunks     Int
  avgChunkSize    Int       // Average words per chunk
  topics          String[]  // Extracted main topics
  speakers        String[]  // Speaker names (if available)
  hasSummary      Boolean   @default(false)
  lastChunkedAt   DateTime  @default(now())

  transcript      Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@index([transcriptId])
}

model Insight {
  id            String    @id @default(uuid())
  insightName   String    // Insight name (e.g. "Gold", "Economy", "Microsoft")
  content       String    @db.Text  // HTML content from editor
  tags          String[]  // Tags for filtering
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt  // Track last modification

  // Relations
  sources       InsightSource[]  // Source transcripts that contributed to this insight
}

// Junction table linking insights to source transcripts
model InsightSource {
  id              String    @id @default(uuid())
  insightId       String
  transcriptId    String
  contentSnippet  String    @db.Text  // The actual text content captured from transcript
  capturedAt      DateTime  @default(now())  // When this content was added
  orderIndex      Int       // Order of appearance in the insight (for sorting)

  // Relations
  insight         Insight     @relation(fields: [insightId], references: [id], onDelete: Cascade)
  transcript      Transcript  @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@unique([insightId, transcriptId, orderIndex])  // Prevent duplicates, allow multiple entries per transcript
  @@index([insightId])
  @@index([transcriptId])
}

/* ─────────────────────────────
   Background-import queue
   ───────────────────────────── */

enum ImportState {
  PENDING
  PROCESSING
  DONE
  ERROR
  CANCELLED
}

model ImportJob {
  id        String      @id @default(uuid())
  url       String
  state     ImportState @default(PENDING)
  progress  Int?        @default(0)
  error     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

/* ─────────────────────────────
   YouTube Search Queue System
   ───────────────────────────── */

model Queue {
  id          String   @id @default(uuid())
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  videos      QueueVideo[]
}

model QueueVideo {
  id            String   @id @default(uuid())
  queueId       String
  youtubeId     String
  title         String
  channel       String
  thumbnailUrl  String?
  duration      String?  // e.g., "45:23"
  viewCount     Int?
  publishedAt   DateTime?
  url           String
  addedAt       DateTime @default(now())

  // Track if already imported
  transcriptId  String?  // If not null, this video has been imported
  importedAt    DateTime?

  queue         Queue      @relation(fields: [queueId], references: [id], onDelete: Cascade)
  transcript    Transcript? @relation(fields: [transcriptId], references: [id])

  @@index([queueId])
  @@index([youtubeId])
}

/* ─────────────────────────────
   Document Generation
   ───────────────────────────── */

enum DocumentStatus {
  ANALYZING          // Stage 0: Analyzing transcripts
  AWAITING_QUESTIONS // Stage 0.5: Ready for iterative questions
  AWAITING_PREVIEW   // Stage 0.75: Ready to show structure preview
  AWAITING_APPROVAL  // User reviewing structure
  GENERATING_OUTLINE // Stage 1
  EXTRACTING         // Stage 2: Extracting content from transcripts
  SYNTHESIZING       // Stage 3: Synthesizing sections
  POLISHING          // Stage 4: Final polish
  COMPLETE
  FAILED
}

model Document {
  id              String          @id @default(uuid())
  title           String
  content         String?         @db.Text         // Nullable until generation complete
  documentType    String                           // "Tutorial Guide", "Analysis", etc.
  preferences     Json                             // User's answers from conversation
  wordCount       Int?
  status          DocumentStatus  @default(ANALYZING)  // NEW: Track generation status
  outline         Json?                            // NEW: Stage 1 output - document structure
  errorMessage    String?         @db.Text         // NEW: For failed generations
  currentStage    String?                          // NEW: "extracting_transcript_3_of_10"
  progress        Int             @default(0)      // NEW: 0-100 percentage
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  transcripts     Transcript[]
  sections        DocumentSection[]     // NEW: Individual sections
  extractions     DocumentExtraction[]  // NEW: Content extracted from transcripts
}

model DocumentSection {
  id              String    @id @default(uuid())
  documentId      String
  sectionNumber   Int                   // Order in the document (1, 2, 3, etc.)
  title           String
  description     String?   @db.Text    // What this section should cover
  content         String?   @db.Text    // Synthesized prose from Stage 3
  keyTopics       Json?                 // Array of topics for preview
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  document        Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, sectionNumber])
  @@index([documentId])
}

model DocumentExtraction {
  id              String    @id @default(uuid())
  documentId      String
  transcriptId    String
  sectionRef      String                // "section_1", "section_2", etc.
  extractType     String                // "founder_quote", "metric_with_timeframe", etc.
  content         String    @db.Text
  context         String?   @db.Text    // Explanation of relevance
  suggestedTypes  Json?                 // Stage 1.5 output: suggested types for this transcript
  createdAt       DateTime  @default(now())

  // Relations
  document        Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  transcript      Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@index([documentId, sectionRef])
  @@index([transcriptId])
  @@index([documentId])
}

/* ─────────────────────────────
   Custom Instructions / Prompt Templates
   ───────────────────────────── */

model PromptTemplate {
  id              String    @id @default(uuid())
  name            String                           // Template name (user-facing)
  description     String?                          // Optional description
  promptText      String    @db.Text               // The actual prompt/instruction text
  category        String[]                         // Categories for filtering
  usageCount      Int       @default(0)            // Track how often it's used
  lastUsedAt      DateTime?                        // Last time template was loaded
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([category])
}

/* ─────────────────────────────
   Agentic Document Generation System
   Completely separate from pipeline system for A/B testing
   ───────────────────────────── */

enum AgentStatus {
  INITIALIZING   // Setting up agent and loading transcripts
  READING        // Agent reading transcripts
  PLANNING       // Agent planning document structure
  WRITING        // Agent writing sections
  POLISHING      // Agent refining content
  COMPLETE       // Generation complete
  FAILED         // Error occurred
}

model AgentDocument {
  id              String        @id @default(uuid())
  title           String
  documentType    String        // Same types as pipeline system
  preferences     Json          // User preferences from setup
  status          AgentStatus   @default(INITIALIZING)
  progress        Int           @default(0)  // 0-100
  currentStage    String?       // Current action description

  // Final output
  content         String?       @db.Text
  wordCount       Int?

  // Agent execution tracking
  conversationId  String?       // Claude API conversation ID
  totalTokens     Int           @default(0)
  totalCost       Float         @default(0)
  toolCallCount   Int           @default(0)

  // Timing
  startedAt       DateTime      @default(now())
  completedAt     DateTime?
  generationTime  Int?          // Seconds

  // Error handling
  errorMessage    String?       @db.Text

  // Variant tracking for A/B testing
  variantId       String?       // baseline, scalable, etc.
  workflowPlan    Json?         // Agent's planned approach (from create_workflow_plan)

  // Metrics for comparison
  transcriptsRead Int           @default(0)  // Full transcript reads
  transcriptsSearched Int       @default(0)  // Search operations
  notesUtilization Float?       // Notes used / total notes

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  transcripts     Transcript[]
  sections        AgentSection[]
  notes           AgentNote[]
  toolCalls       AgentToolCall[]

  @@index([status])
  @@index([variantId])
}

model AgentSection {
  id              String        @id @default(uuid())
  documentId      String
  title           String
  description     String?       @db.Text
  order           Int           // Position in document (1, 2, 3, etc.)
  content         String?       @db.Text
  wordCount       Int?
  revisionCount   Int           @default(0)  // How many times agent updated this
  notesUsedIds    String[]      // IDs of notes incorporated into this section
  writtenAt       DateTime?     // When content was first written
  revisedAt       DateTime?     // Last revision timestamp
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  document        AgentDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, order])
  @@index([documentId])
}

enum NoteImportance {
  CRITICAL  // Must include in document
  HIGH      // Should include if possible
  MEDIUM    // Good to have
  LOW       // Optional, filler content
}

model AgentNote {
  id                String        @id @default(uuid())
  documentId        String
  sectionTitle      String        // Which section this note is for
  content           String        @db.Text
  noteType          String?       // quote, metric, insight, example, method, story, data, task, general
  importance        NoteImportance @default(MEDIUM)  // How critical this note is
  sourceTranscriptId String
  usedInFinal       Boolean       @default(false)  // Track if note made it into final doc
  createdAt         DateTime      @default(now())

  document          AgentDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  transcript        Transcript    @relation(fields: [sourceTranscriptId], references: [id], onDelete: Cascade)

  @@index([documentId, sectionTitle])
  @@index([documentId])
  @@index([importance])
}

model AgentToolCall {
  id              String        @id @default(uuid())
  documentId      String
  toolName        String        // read_transcript, take_note, create_section, etc.
  toolInput       Json          // Arguments passed to tool
  toolOutput      Json?         // What tool returned
  success         Boolean       @default(true)
  errorMessage    String?
  durationMs      Int?          // How long tool took to execute
  calledAt        DateTime      @default(now())

  document        AgentDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([toolName])
}